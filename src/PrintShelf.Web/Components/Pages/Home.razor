@page "/"
@inject CatalogService Catalog

<PageTitle>PrintShelf — Dashboard</PageTitle>

<PageHeader Title="Your 3D print library"
            Subtitle="Dashboard"
            Description="Catalogue, preview and track your STL files. Everything stays on this machine.">
    <a href="/upload" class="btn-primary">
        <span aria-hidden="true">↑</span> Upload STL
    </a>
    <a href="/catalogue" class="btn-secondary">Browse catalogue</a>
</PageHeader>

@if (_error is not null)
{
    <p class="mb-3 rounded border border-rose-800 bg-rose-950/40 px-3 py-2 text-sm text-rose-200" role="alert">
        Could not load the dashboard: @_error
    </p>
}
@if (_data is null)
{
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        @for (int i = 0; i < 4; i++)
        {
            <div class="card p-4 h-24 animate-pulse bg-slate-900"></div>
        }
    </div>
}
else
{
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <StatCard Label="Models" Value="@DisplayFormat.Number(_data.Models)" Hint="live in the catalogue" />
        <StatCard Label="Print runs" Value="@DisplayFormat.Number(_data.Prints)"
                  Hint="@($"{_data.Successes} successful")" />
        <StatCard Label="Success rate"
                  Value="@(_data.Prints == 0 ? "—" : $"{_data.Successes * 100.0 / _data.Prints:0}%")"
                  Hint="across all recorded runs" />
        <StatCard Label="Storage" Value="@DisplayFormat.Bytes(_data.TotalBytes)" Hint="STL files on disk" />
    </div>

    @if (_data.Models == 0)
    {
        <div class="mt-6">
            <EmptyState Title="No models yet" Text="Drag an STL onto the upload page to start your library. Binary and ASCII STL are both supported.">
                <a href="/upload" class="btn-primary">Upload your first STL</a>
                <a href="/settings" class="btn-secondary">Check settings</a>
            </EmptyState>
        </div>
    }
    else
    {
        <div class="mt-8 grid lg:grid-cols-[1fr_20rem] gap-6 items-start">
            <section aria-labelledby="recent-heading">
                <div class="flex items-center justify-between mb-3">
                    <h2 id="recent-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">Recently added</h2>
                    <a href="/catalogue" class="link text-xs">View all</a>
                </div>
                <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                    @foreach (var model in _data.Recent)
                    {
                        <ModelCard Model="model" />
                    }
                </div>
            </section>

            <aside aria-labelledby="most-heading">
                <h2 id="most-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-3">Most printed</h2>
                <div class="card divide-y divide-slate-800">
                    @if (_data.MostPrinted.Count == 0)
                    {
                        <p class="p-4 text-sm text-slate-500">No print runs recorded yet.</p>
                    }
                    else
                    {
                        @foreach (var item in _data.MostPrinted)
                        {
                            <a href="@($"/models/{item.Id}")" class="flex items-center justify-between gap-3 p-3 hover:bg-slate-800/50">
                                <span class="min-w-0">
                                    <span class="block truncate text-sm text-slate-200">@item.Name</span>
                                    <span class="block text-[11px] text-slate-500">@item.Successes/@item.Runs successful · @($"{item.SuccessRate:0}%")</span>
                                </span>
                                <span class="shrink-0 rounded bg-slate-800 px-2 py-1 text-xs tabular-nums text-slate-300">@item.Runs</span>
                            </a>
                        }
                    }
                </div>
                <a href="/catalogue?sort=dims" class="mt-3 block text-center text-xs link">Biggest build volumes →</a>
            </aside>
        </div>
    }
}

@code {
    private DashboardData? _data;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Catalog.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
