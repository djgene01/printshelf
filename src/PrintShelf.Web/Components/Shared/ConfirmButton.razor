<button type="button"
        class="@(Armed ? "btn-danger" : CssClass)"
        disabled="@Disabled"
        @onclick="HandleClick">
    @(Armed ? ConfirmText : Text)
</button>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "Delete";
    [Parameter] public string ConfirmText { get; set; } = "Click again to confirm";
    [Parameter] public string CssClass { get; set; } = "btn-danger";
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    private bool Armed { get; set; }

    private async Task HandleClick()
    {
        if (!Armed)
        {
            Armed = true;
            return;
        }

        Armed = false;
        await OnConfirm.InvokeAsync();
    }
}
