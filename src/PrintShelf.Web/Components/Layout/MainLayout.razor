@inherits LayoutComponentBase

<div class="min-h-dvh flex flex-col md:flex-row">
    <header class="md:hidden bg-slate-900 border-b border-slate-800 px-4 py-3 flex flex-col gap-2">
        <a href="/" class="font-semibold tracking-tight text-slate-50">PrintShelf</a>
        <NavMenu />
    </header>

    <aside class="hidden md:flex md:w-60 md:shrink-0 md:flex-col bg-slate-900 border-r border-slate-800 px-3 py-4 gap-1">
        <a href="/" class="px-3 pb-4 font-semibold tracking-tight text-slate-50 text-lg">
            PrintShelf
            <span class="block text-[11px] font-normal text-slate-500">3D print library</span>
        </a>
        <NavMenu />
        <div class="mt-auto pt-6 px-3 text-[11px] leading-relaxed text-slate-500">
            Local only · no accounts yet (P7)
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0">
        <article class="flex-1 p-4 md:p-8 max-w-6xl w-full mx-auto">
            @Body
        </article>
        <footer class="border-t border-slate-800 px-4 py-3 text-xs text-slate-500">
            PrintShelf — local 3D print catalogue · STL only · LAN only until P7 adds accounts
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
