@page "/admin/integrity"
@inject CatalogService Catalog

<PageTitle>Integrity scan — PrintShelf</PageTitle>

<PageHeader Title="Integrity scan" Subtitle="Admin"
            Description="Compares the database with the files on disk: dangling rows, orphan files, thumbnails and temp staging.">
    <button type="button" class="btn-secondary" disabled="@_busy" @onclick="Scan">Rescan</button>
    <a href="/admin/purge" class="btn-secondary">Purge page</a>
</PageHeader>

@if (_message is not null)
{
    <p class="mb-3 rounded border border-emerald-800 bg-emerald-950/30 px-3 py-2 text-sm text-emerald-200" role="status">@_message</p>
}

@if (_report is null)
{
    <div class="card h-48 animate-pulse"></div>
}
else
{
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <StatCard Label="Live models" Value="@DisplayFormat.Number(_report.LiveModels)" />
        <StatCard Label="Soft-deleted" Value="@DisplayFormat.Number(_report.DeletedModels)" Hint="waiting for purge" />
        <StatCard Label="Library files" Value="@DisplayFormat.Number(_report.LibraryFiles)" Hint="@DisplayFormat.Bytes(_report.LibraryBytes)" />
        <StatCard Label="Thumbnails" Value="@DisplayFormat.Number(_report.ThumbFiles)" />
        <StatCard Label="Temp staging" Value="@DisplayFormat.Bytes(_report.TempBytes)" Hint="uploads in flight" />
    </div>

    @if (IsClean)
    {
        <div class="card border-emerald-800/60 bg-emerald-950/20 p-4 mt-4">
            <p class="text-sm text-emerald-200">✓ No integrity problems: every catalogue row has its file.</p>
            @if (_report.MissingThumbnails.Count > 0)
            {
                <p class="mt-1 text-xs text-emerald-200/70">@_report.MissingThumbnails.Count model(s) have no thumbnail yet — generate them from the Previews page.</p>
            }
        </div>
    }

    @if (_report.DanglingRows.Count > 0)
    {
        <section class="card border-rose-800/60 p-4 mt-4" aria-labelledby="dangling-heading">
            <h2 id="dangling-heading" class="text-sm font-semibold text-rose-300 mb-2">Dangling rows (@_report.DanglingRows.Count)</h2>
            <p class="text-xs text-slate-400 mb-2">Rows whose STL file is missing. Restore the file from backup or purge the row.</p>
            <ul class="space-y-1 text-xs font-mono text-rose-200/80">
                @foreach (string row in _report.DanglingRows)
                {
                    <li>@row</li>
                }
            </ul>
            <a href="/admin/purge" class="btn-secondary text-xs mt-3">Open purge page</a>
        </section>
    }

    @if (_report.OrphanFiles.Count > 0)
    {
        <section class="card p-4 mt-4" aria-labelledby="orphan-heading">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div>
                    <h2 id="orphan-heading" class="text-sm font-semibold text-amber-300">Orphan files (@_report.OrphanFiles.Count)</h2>
                    <p class="text-xs text-slate-400">Files in the library that no catalogue row references. Safe to delete.</p>
                </div>
                <ConfirmButton Text="Delete orphan files" ConfirmText="@($"Delete {_report.OrphanFiles.Count} file(s)?")"
                               CssClass="btn-danger text-xs" OnConfirm="DeleteOrphans" />
            </div>
            <ul class="divide-y divide-slate-800 text-xs font-mono text-slate-400">
                @foreach (var file in _report.OrphanFiles.Take(100))
                {
                    <li class="flex justify-between gap-3 py-1.5">
                        <span class="truncate">@file.FileName</span>
                        <span class="shrink-0 tabular-nums">@DisplayFormat.Bytes(file.Bytes)</span>
                    </li>
                }
            </ul>
            @if (_report.OrphanFiles.Count > 100)
            {
                <p class="text-[11px] text-slate-500 mt-1">…and @(_report.OrphanFiles.Count - 100) more.</p>
            }
        </section>
    }

    @if (_report.MissingThumbnails.Count > 0)
    {
        <section class="card p-4 mt-4" aria-labelledby="thumbs-heading">
            <h2 id="thumbs-heading" class="text-sm font-semibold text-slate-200">Missing thumbnails (@_report.MissingThumbnails.Count)</h2>
            <p class="text-xs text-slate-400 mb-2">Thumbnails are generated by the browser from each STL. Open the Previews page to render all missing ones in one batch.</p>
            <a href="/admin/previews" class="btn-secondary text-xs mb-3">Generate previews</a>
            <ul class="text-xs text-slate-500 columns-2 gap-4">
                @foreach (string name in _report.MissingThumbnails.Take(40))
                {
                    <li class="truncate">@name</li>
                }
            </ul>
        </section>
    }

    @if (_report.UnreferencedThumbnails.Count > 0)
    {
        <section class="card p-4 mt-4">
            <h2 class="text-sm font-semibold text-slate-200">Unreferenced thumbnails (@_report.UnreferencedThumbnails.Count)</h2>
            <p class="text-xs text-slate-400">Cleaned up together with orphan files.</p>
        </section>
    }

    <div class="card p-4 mt-4">
        <h2 class="text-sm font-semibold text-slate-200 mb-1">Temp staging</h2>
        <p class="text-xs text-slate-400">Staged uploads older than 24 hours are abandoned files.</p>
        <button type="button" class="btn-secondary text-xs mt-2" disabled="@_busy" @onclick="CleanTemp">Clean stale temp files</button>
    </div>
}

@code {
    private IntegrityReport? _report;
    private bool _busy;
    private string? _message;

    private bool IsClean =>
        _report is { DanglingRows.Count: 0, OrphanFiles.Count: 0, UnreferencedThumbnails.Count: 0 };

    protected override async Task OnInitializedAsync() => await Scan();

    private async Task Scan()
    {
        _busy = true;
        try
        {
            _report = await Catalog.ScanAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteOrphans()
    {
        _busy = true;
        try
        {
            int removed = await Catalog.PurgeOrphansAsync();
            _message = $"Deleted {removed} orphan file(s).";
            _report = await Catalog.ScanAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CleanTemp()
    {
        int removed = Catalog.CleanStaleTempFiles();
        _message = $"Removed {removed} stale temp file(s).";
        _report = await Catalog.ScanAsync();
    }
}
