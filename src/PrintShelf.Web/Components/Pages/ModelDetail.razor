@page "/models/{Id:guid}"
@inject CatalogService Catalog
@inject PrintRunService Runs
@inject CategoryService Categories
@inject StorageService Storage
@inject SlicerLocator SlicerLocator
@inject SlicerLaunchService SlicerLauncher
@inject NavigationManager Nav

<PageTitle>@(_model?.Name ?? "Model") — PrintShelf</PageTitle>

@if (_loading)
{
    <div class="grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-6">
        <div class="card h-96 animate-pulse"></div>
        <div class="card h-64 animate-pulse"></div>
    </div>
}
else if (_model is null)
{
    <EmptyState Title="Model not found" Text="It may have been deleted, or the link is wrong.">
        <a href="/catalogue" class="btn-primary">Back to catalogue</a>
    </EmptyState>
}
else
{
    <PageHeader Title="@_model.Name" Subtitle="@(_model.Category ?? "Model")"
                Description="@($"Added {DisplayFormat.DateTime(_model.CreatedAt)} · {DisplayFormat.Bytes(_model.FileBytes)}")">
        <a href="@($"/models/{_model.Id}/edit")" class="btn-secondary">Edit details</a>
        <a href="@($"/files/{_model.Id}")" class="btn-secondary" download="@($"{_model.Name}.stl")">Download STL</a>
        <ConfirmButton Text="Delete" ConfirmText="Delete this model?" OnConfirm="DeleteModel" />
    </PageHeader>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-6 items-start">
        <div class="space-y-6 min-w-0">
            <section class="card p-3" aria-labelledby="slicer-heading">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="min-w-0 flex-1">
                        <h2 id="slicer-heading" class="text-sm font-semibold">Open in slicer</h2>
                        <p class="text-xs text-slate-500">Send this STL to a desktop slicer on this PC.</p>
                    </div>

                    @if (_slicers.Any(s => s.Available))
                    {
                        <select class="input w-full sm:w-56" @bind="_slicerKey" aria-label="Slicer application">
                            @foreach (var slicer in _slicers)
                            {
                                <option value="@slicer.Key" disabled="@(!slicer.Available)">
                                    @slicer.Name@(slicer.Available ? "" : " — not installed")
                                </option>
                            }
                        </select>
                        <button type="button" class="btn-primary" data-testid="slicer-launch"
                                disabled="@(!(SelectedSlicer?.Available ?? false) || _launching)"
                                aria-busy="@_launching" @onclick="LaunchInSlicer">
                            @(_launching ? "Opening…" : "Launch")
                        </button>
                    }
                    else
                    {
                        <p class="text-xs text-amber-200">No supported slicer was detected on this PC.</p>
                    }
                </div>

                @if (!_slicers.Any(s => s.Available))
                {
                    <p class="mt-2 text-[11px] leading-relaxed text-slate-500">
                        Install OrcaSlicer, PrusaSlicer, or Cura, or set an explicit executable path in
                        <code class="text-slate-300">Slicers:OrcaPath</code>,
                        <code class="text-slate-300">Slicers:PrusaPath</code>, or
                        <code class="text-slate-300">Slicers:CuraPath</code>.
                    </p>
                }
                else
                {
                    <p class="mt-2 text-[11px] text-slate-500" data-testid="slicer-detected">
                        Detected on this PC: @string.Join(" · ", _slicers.Where(s => s.Available).Select(s => s.Name))
                    </p>
                }

                @if (_slicerMessage is not null)
                {
                    <p class="mt-2 text-xs @(_slicerError ? "text-rose-300" : "text-emerald-300")"
                       role="@(_slicerError ? "alert" : "status")">@_slicerMessage</p>
                }
            </section>

            <StlViewer ModelId="_model.Id" HasThumb="_hasThumb" MaterialColor="@_materialColor"
                       DownloadName="@($"{_model.Name}-preview.png")"
                       OnThumbnailCaptured="ThumbnailSaved" />

            @if (!string.IsNullOrWhiteSpace(_model.Description))
            {
                <section class="card p-4" aria-labelledby="desc-heading">
                    <h2 id="desc-heading" class="text-[11px] uppercase tracking-wider text-slate-500 mb-1">Description</h2>
                    <p class="text-sm text-slate-300 whitespace-pre-line">@_model.Description</p>
                </section>
            }

            <section aria-labelledby="runs-heading">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <h2 id="runs-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">
                        Print runs <span class="text-slate-600">(@_model.PrintRuns.Count)</span>
                    </h2>
                    <button type="button" class="btn-primary text-xs" @onclick="StartAdd">
                        <span aria-hidden="true">+</span> Record print
                    </button>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
                    <div class="card p-3">
                        <div class="text-[10px] uppercase tracking-wider text-slate-500">Runs</div>
                        <div class="text-lg font-semibold tabular-nums">@_aggregate.Runs</div>
                    </div>
                    <div class="card p-3">
                        <div class="text-[10px] uppercase tracking-wider text-slate-500">Success</div>
                        <div class="text-lg font-semibold tabular-nums">@(_aggregate.Runs == 0 ? "—" : $"{_aggregate.SuccessRate:0}%")</div>
                    </div>
                    <div class="card p-3">
                        <div class="text-[10px] uppercase tracking-wider text-slate-500">Total time</div>
                        <div class="text-lg font-semibold tabular-nums">@(_aggregate.Runs == 0 ? "—" : _aggregate.TotalTimeDisplay)</div>
                    </div>
                    <div class="card p-3">
                        <div class="text-[10px] uppercase tracking-wider text-slate-500">Cost</div>
                        <div class="text-lg font-semibold tabular-nums">@_aggregate.TotalCost.ToString("0.00")</div>
                    </div>
                </div>

                @if (_showForm)
                {
                    <div class="mb-3">
                        <PrintRunForm ModelId="_model.Id" Run="_editingRun"
                                      Printers="_printers" Materials="_materials"
                                      OnSaved="RunSaved" OnCancel="CancelForm" />
                    </div>
                }

                @if (_model.PrintRuns.Count == 0)
                {
                    <div class="card p-4 text-sm text-slate-500">
                        No print runs yet. Record the first one to start tracking success rate and cost.
                    </div>
                }
                else
                {
                    <div class="card overflow-x-auto">
                        <table class="table-base">
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Printer</th>
                                    <th scope="col">Material</th>
                                    <th scope="col">Result</th>
                                    <th scope="col" class="text-right">Time</th>
                                    <th scope="col" class="text-right">Cost</th>
                                    <th scope="col">Notes</th>
                                    <th scope="col"><span class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in _model.PrintRuns)
                                {
                                    <tr>
                                        <td class="whitespace-nowrap text-xs text-slate-400">@DisplayFormat.Date(run.PrintedAt)</td>
                                        <td class="text-sm">@run.Printer</td>
                                        <td class="text-xs text-slate-400">
                                            @(run.Material ?? "—")@(string.IsNullOrWhiteSpace(run.Color) ? "" : $" · {run.Color}")
                                        </td>
                                        <td>
                                            <span class="@ResultClass(run.Result)">@run.Result</span>
                                        </td>
                                        <td class="text-right text-xs tabular-nums text-slate-400">
                                            @(run.DurationMin is { } minutes ? FormatMinutes(minutes) : "—")
                                        </td>
                                        <td class="text-right text-xs tabular-nums text-slate-400">
                                            @(run.Cost?.ToString("0.00") ?? "—")
                                        </td>
                                        <td class="text-xs text-slate-500 max-w-48 truncate" title="@run.Notes">@run.Notes</td>
                                        <td class="text-right whitespace-nowrap">
                                            <button type="button" class="btn-ghost text-xs" @onclick="() => StartEdit(run)">Edit</button>
                                            <ConfirmButton Text="Delete" ConfirmText="Confirm"
                                                           CssClass="btn-ghost text-xs text-rose-300"
                                                           OnConfirm="() => DeleteRun(run)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <aside class="space-y-4">
            <section class="card p-4" aria-labelledby="stats-heading">
                <h2 id="stats-heading" class="text-[11px] uppercase tracking-wider text-slate-500 mb-2">Geometry & file</h2>
                <dl class="space-y-2 text-sm">
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Triangles</dt><dd class="tabular-nums">@DisplayFormat.Number(_model.TriCount)</dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Dimensions</dt><dd class="tabular-nums text-right">@($"{_model.BboxX:0.##} × {_model.BboxY:0.##} × {_model.BboxZ:0.##}")<span class="text-slate-500"> @_model.PrintUnit</span></dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Volume <span class="text-[10px]">(est.)</span></dt><dd class="tabular-nums text-right">@(_model.VolumeMm3?.ToString("0.##") ?? "—")<span class="text-slate-500"> @(_model.PrintUnit)³</span></dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">File size</dt><dd class="tabular-nums">@DisplayFormat.Bytes(_model.FileBytes)</dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Format</dt><dd class="uppercase">@_model.Format</dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Added</dt><dd>@DisplayFormat.Date(_model.CreatedAt)</dd></div>
                </dl>

                @if (_model.VolumeMm3 is null or 0)
                {
                    <p class="mt-3 rounded border border-amber-700/50 bg-amber-950/20 px-2 py-1.5 text-[11px] text-amber-200">
                        Volume is ~0: the mesh is probably not watertight. Dimensions are still measured.
                    </p>
                }

                <p class="mt-3 text-[11px] leading-relaxed text-slate-500">
                    STL files carry no unit. PrintShelf assumes <span class="text-slate-300">@_model.PrintUnit</span> — change it in
                    <a class="link" href="@($"/models/{_model.Id}/edit")">edit details</a> if the model was authored in inches.
                </p>
            </section>

            <section class="card p-4" aria-labelledby="tags-heading">
                <h2 id="tags-heading" class="text-[11px] uppercase tracking-wider text-slate-500 mb-2">Tags</h2>
                @if (_model.ModelTags.Count == 0)
                {
                    <p class="text-xs text-slate-500">No tags. <a class="link" href="@($"/models/{_model.Id}/edit")">Add some</a>.</p>
                }
                else
                {
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var link in _model.ModelTags)
                        {
                            <a href="@($"/catalogue?tag={link.TagId}")" class="chip hover:bg-slate-700">@link.Tag.Label</a>
                        }
                    </div>
                }
            </section>

            <section class="card p-4">
                <h2 class="text-[11px] uppercase tracking-wider text-slate-500 mb-2">Fingerprint</h2>
                <p class="font-mono text-[10px] break-all text-slate-500">@_model.FileSha256.Trim()</p>
                <p class="mt-2 text-[11px] text-slate-500">Files are stored content-addressed by this SHA-256.</p>
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private StlModel? _model;
    private bool _loading = true;
    private bool _hasThumb;
    private string _materialColor = CategoryService.DefaultColor;
    private bool _showForm;
    private PrintRun? _editingRun;
    private PrintAggregate _aggregate = new(0, 0, 0, 0, 0, 0, null);
    private IReadOnlyList<string> _printers = [];
    private IReadOnlyList<string> _materials = [];
    private IReadOnlyList<SlicerInstall> _slicers = [];
    private string _slicerKey = "";
    private bool _launching;
    private string? _slicerMessage;
    private bool _slicerError;

    private SlicerInstall? SelectedSlicer =>
        _slicers.FirstOrDefault(s => string.Equals(s.Key, _slicerKey, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _slicers = SlicerLocator.Detect();
        _slicerKey = _slicers.FirstOrDefault(s => s.Available)?.Key ?? _slicers.FirstOrDefault()?.Key ?? "";
        await ReloadAsync();
        _printers = await Runs.SuggestPrintersAsync();
        _materials = await Runs.SuggestMaterialsAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _model = await Catalog.GetModelAsync(Id);
        if (_model is null)
        {
            _loading = false;
            return;
        }
        _hasThumb = Storage.ThumbExists(_model.FileSha256.Trim());
        _materialColor = await Categories.ColorForAsync(_model.Category);
        _aggregate = PrintRunService.Aggregate(_model.PrintRuns);
    }

    private void StartAdd()
    {
        _editingRun = null;
        _showForm = true;
    }

    private void StartEdit(PrintRun run)
    {
        _editingRun = run;
        _showForm = true;
    }

    private void CancelForm() => _showForm = false;

    private async Task RunSaved()
    {
        _showForm = false;
        _editingRun = null;
        await ReloadAsync();
        _printers = await Runs.SuggestPrintersAsync();
        _materials = await Runs.SuggestMaterialsAsync();
    }

    private async Task DeleteRun(PrintRun run)
    {
        await Runs.DeleteAsync(run.Id);
        await ReloadAsync();
    }

    private async Task DeleteModel()
    {
        await Catalog.SoftDeleteAsync(Id);
        Nav.NavigateTo("/catalogue");
    }

    private Task ThumbnailSaved()
    {
        _hasThumb = true;
        return Task.CompletedTask;
    }

    private async Task LaunchInSlicer()
    {
        if (_launching || _model is null)
            return;

        _launching = true;
        _slicerMessage = null;
        _slicerError = false;
        SlicerLaunchResult result = await SlicerLauncher.LaunchAsync(_model.Id, _slicerKey);
        _slicerMessage = result.Message;
        _slicerError = !result.Success;
        _launching = false;
    }

    private static string ResultClass(string result) => result switch
    {
        PrintResults.Success => "inline-flex rounded bg-emerald-500/15 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-emerald-300",
        PrintResults.Failed => "inline-flex rounded bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-rose-300",
        _ => "inline-flex rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-amber-300"
    };

    private static string FormatMinutes(int minutes) =>
        minutes >= 60 ? $"{minutes / 60}h {minutes % 60}m" : $"{minutes}m";
}
